{
  "name": "synaprank-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Synaprank.ai — enterprise console for autonomous SEO, AEO and programmatic ads",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:responsive": "playwright test -c e2e/playwright.config.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "simple-icons": "^16.30.0",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "6.4.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
