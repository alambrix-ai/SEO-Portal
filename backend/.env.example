# ═══════════════════════════════════════════════════════════════════════════
#  Synaprank.ai — backend configuration
#
#  Copy to .env and fill in. Values marked REQUIRED IN PRODUCTION are checked
#  at startup: the app refuses to boot with APP_ENV=production without them.
#  Run `python manage.py check` for a pre-flight report.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────
# development = local SMTP | test = Resend | staging/production = Resend
APP_ENV=test
APP_NAME="Synaprank.ai"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Base for the links in invitation emails.
# REQUIRED IN PRODUCTION to be https.
PUBLIC_BASE_URL=http://localhost:5173
# Where the API is reachable from the internet, when it is not behind the
# console's own address (e.g. https://automarket-api.onrender.com). Blank
# means PUBLIC_BASE_URL. Sign-in redirect URIs are built from it.
PUBLIC_API_BASE_URL=

# ── Sign-in providers ("Sign in with Google") ──────────────────────────────
# Optional. When set, customers connect Google Analytics 4, Search Console,
# Google Ads and Business Profile with one sign-in button instead of pasting
# client ids and refresh tokens. Register this redirect URI on the OAuth
# client:  {PUBLIC_API_BASE_URL or PUBLIC_BASE_URL}/api/v1/oauth/callback/google
# Portal Admin → Sign-in providers shows the exact value. See docs/oauth-setup.md.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# The platform's Google Ads API developer token (Basic or Standard access).
# Google Ads sign-in is offered only when this is set; customers never see it.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Minutes a sign-in may take before its state expires (single use either way).
OAUTH_STATE_TTL_MINUTES=10

# OAuth providers: social and ads (phase 2A). Optional, one app per vendor.
# Redirect URI for each: {PUBLIC_API_BASE_URL or PUBLIC_BASE_URL}/api/v1/oauth/callback/<provider>
# with <provider> = meta, linkedin, linkedin_pages, x, pinterest, tiktok,
# microsoft, bing_webmaster. Setup and app review: docs/oauth-setup-social-ads.md
OAUTH_META_CLIENT_ID=
OAUTH_META_CLIENT_SECRET=
# Graph API version for all Meta connectors. Blank = the version this release
# was built for. Set it (e.g. v27.0) when Meta retires that one, then restart.
# META_GRAPH_API_VERSION=
# LinkedIn app with the Advertising API (LinkedIn Ads).
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
# A separate LinkedIn app with only the Community Management API (LinkedIn Pages).
OAUTH_LINKEDIN_PAGES_CLIENT_ID=
OAUTH_LINKEDIN_PAGES_CLIENT_SECRET=
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_PINTEREST_CLIENT_ID=
OAUTH_PINTEREST_CLIENT_SECRET=
# TikTok for Business: the developer app's App ID and Secret.
OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=
# Microsoft Entra app registration for Microsoft Advertising.
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# The platform's Microsoft Advertising universal developer token. Microsoft Ads
# sign-in is offered only when this is set; customers never see it.
MICROSOFT_ADS_DEVELOPER_TOKEN=
# TikTok sandbox API address, used only by TikTok Ads connections marked Sandbox.
# Leave unset for the default (https://sandbox-ads.tiktok.com/open_api/v1.3); if
# TikTok rejects it, use the address your TikTok developer portal shows.
# TIKTOK_SANDBOX_BASE_URL=
OAUTH_BING_WEBMASTER_CLIENT_ID=
OAUTH_BING_WEBMASTER_CLIENT_SECRET=

# OAuth providers: business apps (phase 2B). Optional, one app per vendor.
# Redirect URI for each: {PUBLIC_API_BASE_URL or PUBLIC_BASE_URL}/api/v1/oauth/callback/<provider>
# (slack, hubspot, salesforce, mailchimp, klaviyo, shopify, github, bitbucket,
# webflow). See docs/oauth-setup-business-apps.md.
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_HUBSPOT_CLIENT_ID=
OAUTH_HUBSPOT_CLIENT_SECRET=
OAUTH_SALESFORCE_CLIENT_ID=
OAUTH_SALESFORCE_CLIENT_SECRET=
OAUTH_MAILCHIMP_CLIENT_ID=
OAUTH_MAILCHIMP_CLIENT_SECRET=
OAUTH_KLAVIYO_CLIENT_ID=
OAUTH_KLAVIYO_CLIENT_SECRET=
OAUTH_SHOPIFY_CLIENT_ID=
OAUTH_SHOPIFY_CLIENT_SECRET=
# GitHub App: client id/secret, plus slug, App ID and private key (PEM; a
# single line with \n escapes is accepted). "Install on GitHub" needs all five.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
OAUTH_BITBUCKET_CLIENT_ID=
OAUTH_BITBUCKET_CLIENT_SECRET=
OAUTH_WEBFLOW_CLIENT_ID=
OAUTH_WEBFLOW_CLIENT_SECRET=
# Platform-provided Google API keys: one-click "Use the included access" for
# PageSpeed Insights and Google Maps search. Calls (and Places billing) are on
# the platform's own Cloud project.
PLATFORM_PAGESPEED_API_KEY=
PLATFORM_GOOGLE_PLACES_API_KEY=

# ── Sessions & tokens ──────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — signs access tokens.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=14

# ── One-time passcodes ─────────────────────────────────────────────────────
# There are no passwords. Signing in means proving control of a mailbox: the
# server emails a code and the caller sends it back. These four numbers are
# therefore the entire security margin of the login system.
#
# Six digits is a million possibilities, which is only safe because a code
# lives for minutes, dies after a few wrong guesses, and is replaced the moment
# another is requested. Shortening the TTL or tightening the attempt cap buys
# far more than lengthening the code.
LOGIN_CODE_LENGTH=6
# Startup refuses more than 30 in production: a live credential sitting in a
# mailbox should not be valid for an hour.
LOGIN_CODE_TTL_MINUTES=10
# Wrong guesses before the code is dead. Production refuses more than 10.
LOGIN_CODE_MAX_ATTEMPTS=5
# Minimum gap between codes for one address: stops the sign-in form being used
# as a mail cannon, and stops an attacker cycling codes to widen the space
# they can guess against.
LOGIN_CODE_RESEND_SECONDS=60

# ── Encryption at rest ─────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Master key-encrypting key, base64 of 32 bytes.
# Every organisation's own data key is wrapped with this one. Losing it means
# losing all customer payloads; leaking it undoes encryption at rest. Keep it
# in a secret manager or KMS, never in the repo.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=
MASTER_KEY_VERSION=1
# Previous keys, so rows written under them stay readable while you re-wrap
# with `manage.py rotate-keys`. Comma-separated "<version>:<base64key>".
MASTER_ENCRYPTION_KEY_RETIRED=

# REQUIRED IN PRODUCTION. Separate HMAC key for blind indexes (encrypted-email
# lookup) and for hashing refresh/verification tokens. Must differ from the
# master key — startup rejects them being equal.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BLIND_INDEX_KEY=

# ── Transport security ─────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION to be true: redirects http->https and emits HSTS.
# Production also needs TRUSTED_PROXIES (the proxy that terminates TLS) or
# EDGE_TLS_TERMINATED=true; with neither, every request looks like plain
# http and the redirect loops, so startup refuses it. /health is never
# redirected (container health checks speak plain http).
FORCE_HTTPS=false
# TLS ends at a platform edge whose addresses cannot be listed in
# TRUSTED_PROXIES (Render). The app then skips its own redirect and leaves it
# to the edge; HSTS is still sent.
EDGE_TLS_TERMINATED=false
HSTS_MAX_AGE_SECONDS=31536000
SECURE_COOKIES=true
COOKIE_DOMAIN=
# REQUIRED IN PRODUCTION — the real hostnames, not "*" and not empty.
# TRUSTED_HOSTS= (blank) disables the host check (any Host header is
# accepted). Production refuses to start with that. /health is exempt, so a
# health check on Host: localhost still works.
TRUSTED_HOSTS=*

# ── CORS ───────────────────────────────────────────────────────────────────
# The origins the console is served from. List the real public origin FIRST:
# WebAuthn/passkeys take the RP ID from the first CORS origin's hostname.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Enterprise SSO (SAML / OIDC) ───────────────────────────────────────────
# Fail-closed: SSO login endpoints refuse until this is true. Leave false
# until an IdP is certified for this deployment.
SSO_LOGIN_ENABLED=false
# Clock skew allowed when validating assertion/token timestamps (seconds).
SSO_CLOCK_SKEW_SECONDS=120
# How long a used assertion/jti is remembered to block replays (seconds).
SSO_REPLAY_TTL_SECONDS=600

# ── Commercial billing ─────────────────────────────────────────────────────
# Provider abstraction. Only "fake" is enabled without a business decision;
# other names refuse at startup / call time.
BILLING_PROVIDER=fake
# Optional JSON plan catalogue override. Empty = built-in fake catalogue only.
# Example: {"starter":{"seats":5,"price_cents":0},"pro":{"seats":25,"price_cents":0}}
BILLING_PLAN_CATALOG=

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=automarket
POSTGRES_USER=automarket_app
# Set per environment (a secret manager in production). Never commit a real value.
POSTGRES_PASSWORD=
# REQUIRED IN PRODUCTION: require | verify-ca | verify-full. Applies to
# DATABASE_URL too when it has no ?sslmode= of its own.
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
# A full DSN overrides the POSTGRES_* fields. Neon / Render URLs work as-is:
#   postgresql://user:pass@host/db?sslmode=require
# (rewritten to postgresql+psycopg:// on load)
# DATABASE_URL=postgresql+psycopg://automarket_app:pass@host:5432/automarket?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Postgres row-level security. Leave on: it is the backstop that keeps one
# organisation's rows out of another's console if a query forgets its filter.
DB_ENFORCE_RLS=true
# Refuse to start when the role in DATABASE_URL is a superuser, has BYPASSRLS,
# or owns any RLS-protected table (each would switch row-level security or the
# append-only audit log off). Checked on API and Celery worker startup in every
# environment. true ONLY for a throwaway local/test environment without a
# separate app role (never for real customer data).
ALLOW_PRIVILEGED_DB_ROLE=false

# ── Registration policy ────────────────────────────────────────────────────
ALLOW_PUBLIC_SIGNUP=true
BLOCK_PUBLIC_EMAIL_DOMAINS=false

# Platform Portal Admin — comma-separated emails that can open /portal and
# enable or disable connectors, agents and modules for every workspace.
# Empty = nobody is a portal admin.
PORTAL_ADMIN_EMAILS=

# ── Rate limiting & lockout ────────────────────────────────────────────────
# REQUIRED IN PRODUCTION to be true. This is what keeps the code-request
# endpoints from being used to enumerate addresses or flood a mailbox.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=240
# Wrong codes across any number of issued codes before the account itself is
# locked. Without this, an attacker could request a new code they cannot read
# and guess a few times against each, indefinitely.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
# Requests one signed-in user may make per minute, and model calls one
# workspace may start per minute.
USER_RATE_LIMIT_PER_MINUTE=120
LLM_RATE_LIMIT_PER_TENANT_PER_MINUTE=20
# The reverse proxies in front of the API, as IPs or CIDRs (comma-separated).
# Only these may tell the API the real client address (X-Forwarded-For).
# Empty = the connecting address is the client. Production refuses 0.0.0.0/0
# and ::/0. Examples: nginx on the same host -> 127.0.0.1/32,::1/128
# Required for correct per-workspace IP allowlist enforcement behind a proxy:
# without TRUSTED_PROXIES the API never trusts X-Forwarded-For, so allowlists
# see the proxy's address instead of the client.
TRUSTED_PROXIES=
# Largest request body accepted, in bytes (1 MB). Larger requests get a 413.
# Image uploads are exempt and capped by CREATIVE_UPLOAD_MAX_BYTES.
MAX_REQUEST_BODY_BYTES=1048576

# ── Outbound email ─────────────────────────────────────────────────────────
# Chosen by APP_ENV (not by which keys happen to be set):
#   APP_ENV=development          → SMTP_* (local / Gmail)
#   APP_ENV=test                 → RESEND_API_KEY (hosted testing)
#   APP_ENV=staging|production   → RESEND_API_KEY (Render blocks SMTP)
#
# REQUIRED IN PRODUCTION: RESEND_API_KEY.
# In development with SMTP_HOST empty, nothing is sent; see DEV_LOG_SIGN_IN_CODES
# below to have sign-in codes written to the log instead.
RESEND_API_KEY=
# Free Resend testing sender (only delivers to your Resend account email):
# EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=
# Development only: with SMTP_HOST empty, also print each one-time sign-in
# code to the API log (never the address). Any other APP_ENV refuses to start
# with this on.
# DEV_LOG_SIGN_IN_CODES=true

# ── Agent orchestration ────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# Divides every agent interval. Leave at 1.0 in production; raise it in
# development so a run is observable in minutes rather than hours.
SCHEDULER_SPEED=1.0

# Set true to move agent runs onto Celery workers instead of the API process.
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=2
# Worker processes are recycled after this many tasks.
CELERY_MAX_TASKS_PER_CHILD=50
# The "render" queue: one browser per process, recycled at this memory (KiB).
CELERY_RENDER_CONCURRENCY=1
CELERY_MAX_MEMORY_PER_CHILD_KB=1500000
# Redis for the worker heartbeat (redis:// or rediss://). Blank uses
# CELERY_BROKER_URL when that is Redis. Never logged.
REDIS_URL=

# ── Migrations ─────────────────────────────────────────────────────────────
# Whether the container runs `alembic upgrade head` on start.
RUN_MIGRATIONS=true
# Schema-owner DSN for Alembic only (automarket_owner). Blank falls back to
# DATABASE_URL with a loud warning — set this in every non-local environment.
# DATABASE_ADMIN_URL is accepted as an alias for the same value.
# When creating roles via migration 0049, also set AUTOMARKET_OWNER_PASSWORD
# and AUTOMARKET_APP_PASSWORD (never commit real values).
MIGRATION_DATABASE_URL=
# DATABASE_ADMIN_URL=
# AUTOMARKET_OWNER_PASSWORD=
# AUTOMARKET_APP_PASSWORD=

# ── AI model (agents) ──────────────────────────────────────────────────────
# Agents do NOT use LLM_PROVIDER / LLM_MODEL / vendor API keys from this file.
# Connect OpenAI, Anthropic Claude, Google Gemini, or Perplexity under
# Connectors, then pick which connected model each agent should use in
# Configure. Keys and model names live on those connectors.

# Optional shared transport / spend knobs (still used when a connector runs):
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
ANTHROPIC_API_VERSION=2023-06-01
# Per-model prices as JSON: {"<connector>:<model pattern>": [input, output]}
# per million tokens, e.g. {"openai:gpt-5*": [1.25, 10]}. Invalid JSON
# refuses to start. Empty = the two flat prices above.
LLM_PRICE_TABLE=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROK_BASE_URL=https://api.x.ai

# Legacy / unused by agent runs (safe to leave blank):
# LLM_PROVIDER=
# LLM_MODEL=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROK_API_KEY=

# ── SEO Assistant (platform LLM from .env — NOT workspace connectors) ──────
# Powers /assistant Ask + Action. Agents still use connected AI model
# connectors; the assistant always uses these server env values.
ANTHROPIC_API_KEY=
# Required for the assistant: a model id from your Anthropic Console
# (Console → Models, or GET https://api.anthropic.com/v1/models). No default.
ASSISTANT_MODEL=
# Optional: ASSISTANT_MODEL falls back to LLM_MODEL when unset.
# LLM_MAX_TOKENS / LLM_EFFORT above also apply to the assistant.
# Conversation memory uses LlamaIndex ChatMemoryBuffer + SimpleChatEngine
# (prior turns from the client, token-budgeted — not a fixed last-N dump).

# There is no fallback model. If the connector the operator picked is missing
# or unreachable, the agent skips and says so in plain language.

# ── Orchestration tuning ───────────────────────────────────────────────────
# How much work one tick may claim, in total and per workspace, so a busy
# organisation cannot monopolise a tick.
SCHEDULER_MAX_PER_TICK=12
SCHEDULER_MAX_PER_TENANT_PER_TICK=4
# How long a claimed agent is left alone before another worker may retry it.
# Longer than the slowest agent run, shorter than its interval.
SCHEDULER_CLAIM_LEASE_MINUTES=15
# How often connected integrations are re-probed, so the Connectors screen
# stays current without anybody pressing anything.
CONNECTOR_HEALTH_SWEEP_MINUTES=30
# Consecutive failures before an agent is parked for a human to look at.
AGENT_MAX_CONSECUTIVE_FAILURES=5

# ── Connector transport ────────────────────────────────────────────────────
CONNECTOR_TIMEOUT_SECONDS=20
CONNECTOR_MAX_ATTEMPTS=3
# Private hostnames or CIDRs that connectors with an address the customer
# types (WordPress, Magento, custom API, webhooks) may reach, comma-separated,
# e.g. wp.intranet.example,10.20.0.0/16. Leave blank unless you run those
# systems on a private network. Public addresses need no entry; cloud metadata
# addresses are always blocked; 0.0.0.0/0 and ::/0 are refused. Listed hosts
# are still reached over https only, with the certificate verified (use a
# certificate your servers trust). The Site Crawler never uses this list.
CONNECTOR_PRIVATE_HOSTS_ALLOWED=
# Ceiling on a repository walk, for the GitHub and Bitbucket connectors.
# Narrow the content folder rather than raising these.
REPO_MAX_FILES=4000
REPO_MAX_DEPTH=6

# ── Site crawler ───────────────────────────────────────────────────────────
# Ceiling on one crawl of a customer's site. Bounded because the platform is
# fetching somebody's production pages on a schedule, not browsing.
CRAWLER_MAX_PAGES=300

# ── What counts as a page in a repository ──────────────────────────────────
# The built-in list already covers Markdown, the template languages, and the
# server-rendered stacks (.php, .erb, .twig, .cshtml). These two add to it
# rather than replacing it, so a stack nobody here has heard of is one line
# of configuration away from working instead of a code change.
#   CONTENT_EXTENSIONS_EXTRA=.dhtml,.shtml
CONTENT_EXTENSIONS_EXTRA=
# Directory names that mark where routing starts, used to turn a file path
# into the URL it is published at.
#   ROUTE_DIRS_EXTRA=pagina,seiten
ROUTE_DIRS_EXTRA=

# ── Technical SEO audit ────────────────────────────────────────────────────
# Google publishes no minimum word count. 300 is a working threshold for
# "thin", which is why it is a setting you can argue with per deployment
# rather than a constant in the code.
SEO_THIN_CONTENT_WORDS=300
# Core Web Vitals field data is quota-limited, so one run measures a bounded
# number of pages rather than the whole site every time.
SEO_VITALS_PAGES_PER_RUN=25
# Page bodies fetched per sync. The listing is one call; each body is another,
# against the customer's own site, so a large site fills in over a few runs
# rather than being re-read in full every time.
SEO_PAGES_READ_PER_RUN=25

# ── What a new workspace gets ──────────────────────────────────────────────
# Commercial facts, which change without the software changing.
DEFAULT_PLAN_NAME=Enterprise Plan
DEFAULT_SEATS=25
DEFAULT_PLAN_DAYS=30
# Where a freshly reset agent sends notifications: Slack | Email | None.
# None by default, so a reset cannot start delivering somewhere nobody chose.
DEFAULT_NOTIFY_CHANNEL=None

# ── Money ──────────────────────────────────────────────────────────────────
# What the customer's spend and CAC are reported in. Grouping is separate from
# the symbol because it is not implied by it: "indian" gives the lakh/crore
# grouping (₹12,34,567 and ₹4.57Cr), "western" gives thousands.
CURRENCY_SYMBOL=₹
CURRENCY_GROUPING=indian

# ── LinkedIn REST API ──────────────────────────────────────────────────────
# The Linkedin-Version header (YYYYMM). LinkedIn retires each version after
# about a year; move it forward when LinkedIn announces a sunset.
LINKEDIN_API_VERSION=202610

# ── Self-hosted models (Ollama, vLLM) ──────────────────────────────────────
# Private hostnames or CIDRs a self-hosted model connector may reach
# (comma-separated). Public addresses need no entry. Cloud metadata addresses
# are always blocked, and 0.0.0.0/0 or ::/0 is refused.
SELF_HOSTED_LLM_ALLOWED_HOSTS=
SELF_HOSTED_LLM_TIMEOUT_SECONDS=60
# Plain http to a self-hosted model server. Off by default. When on, only for
# addresses inside a CIDR listed above (a hostname entry alone never allows
# http), and no credentials are sent over it.
SELF_HOSTED_LLM_ALLOW_PLAIN_HTTP=false
# Ports a self-hosted model server may listen on (comma-separated, 1-65535).
SELF_HOSTED_LLM_ALLOWED_PORTS=443,8000,11434

# ── Creative Studio ────────────────────────────────────────────────────────
CREATIVE_ENABLED=true
# Model ids allowed for writing and for images, as comma-separated glob
# patterns ("<connector>:" prefix optional, e.g. ollama:*). The deny lists
# win. An EMPTY allow list approves nothing: Creative Studio then tells people
# "An administrator needs to approve AI models for Creative Studio."
# The values below are the recommended lists. Model ids change often, so
# review them against each vendor's model list before going live.
CREATIVE_ALLOWED_TEXT_MODELS=claude-*,gpt-*,o[0-9]*,gemini-*,sonar*,grok-*,ollama:*,vllm:*
CREATIVE_DENIED_TEXT_MODELS=*image*,*realtime*,*audio*,*tts*,*transcribe*,*embedding*,*-live*,gemini-nano-banana*,*video*
CREATIVE_ALLOWED_IMAGE_MODELS=gpt-image-*,chatgpt-image-*,gemini-*-image*,gemini-nano-banana*
CREATIVE_DENIED_IMAGE_MODELS=dall-e-*,gpt-image-1
# Monthly quotas per workspace (0 = no cap).
CREATIVE_JOBS_PER_MONTH=100
CREATIVE_IMAGES_PER_MONTH=200
CREATIVE_TOKENS_PER_MONTH=0
# Per-job ceilings.
CREATIVE_MAX_FORMATS_PER_JOB=8
CREATIVE_MAX_REVISIONS=5
CREATIVE_MAX_IMAGES_PER_JOB=4
CREATIVE_MAX_TOKENS_PER_CALL=2000
# Uploads and storage.
CREATIVE_UPLOAD_MAX_BYTES=5242880
CREATIVE_UPLOAD_MAX_PIXELS=40000000
CREATIVE_SVG_MAX_BYTES=1048576
CREATIVE_STORAGE_MAX_BYTES_PER_TENANT=2147483648
# Rendering: chromium (needs the browser in the image) or pillow.
CREATIVE_RENDERER=chromium
# Chromium's own sandbox needs user namespaces, which most containers lack.
# Leave false unless the container grants them; the container is locked down.
# Production refuses false unless CELERY_ENABLED=true (renders leave this
# process) or the renderer is pillow. CREATIVE_RENDER_ISOLATED=true does
# not count without Celery.
CREATIVE_CHROMIUM_SANDBOX=false
# Confirms Chromium runs only in the dedicated, locked-down render worker.
# docker-compose.yml sets this on render-worker only. See docs/deployment.md.
CREATIVE_RENDER_ISOLATED=false
CREATIVE_RENDER_TIMEOUT_SECONDS=30
# Celery limits for one whole creative job (soft must be below hard).
CREATIVE_RENDER_SOFT_TIME_LIMIT=600
CREATIVE_RENDER_TIME_LIMIT=660
CREATIVE_MAX_CONCURRENT_RENDERS=2
CREATIVE_JOB_MAX_CONCURRENT=2
# Google Display rejects banners over 150 KB.
CREATIVE_BANNER_MAX_KB=150

# ── Stored files and fetched images ────────────────────────────────────────
# postgres only for now; production refuses s3.
STORAGE_BACKEND=postgres
# Hostnames an image may be downloaded from when a model returns a link.
# Empty = link downloads are off (images arrive as base64).
IMAGE_FETCH_ALLOWED_HOSTS=
IMAGE_FETCH_MAX_BYTES=20000000

# ── Retention (days) ───────────────────────────────────────────────────────
RETENTION_LOGIN_CODES_DAYS=7
RETENTION_REFRESH_TOKENS_DAYS=30
RETENTION_DEMO_ANALYSES_DAYS=90

# ── Audit export ───────────────────────────────────────────────────────────
AUDIT_EXPORT_MAX_ROWS=50000
AUDIT_EXPORT_MAX_DAYS=366

# ── Reddit ─────────────────────────────────────────────────────────────────
# Reddit requires written approval for commercial API use. Off by default.
REDDIT_ENABLED=false
OAUTH_REDDIT_CLIENT_ID=
OAUTH_REDDIT_CLIENT_SECRET=
# Required by Reddit: "<platform>:<app id>:<version> (by /u/<username>)"
REDDIT_USER_AGENT=
REDDIT_MIN_MINUTES_BETWEEN_POSTS=10

# ── Social posting and metrics ─────────────────────────────────────────────
SOCIAL_METRICS_INTERVAL_HOURS=6
SOCIAL_METRICS_LOOKBACK_DAYS=30
SOCIAL_PUBLISH_MAX_ATTEMPTS=3
SOCIAL_PUBLISH_RETRY_MINUTES=15
# X bills every read; one metrics run reads at most this many posts.
X_METRICS_MAX_READS_PER_RUN=100
# Days of history read the first time a data source appears.
METRICS_BACKFILL_DAYS=90
# Social posts one workspace may publish in any 24 hours (1-500). A
# workspace's own setting overrides it.
SOCIAL_DAILY_POST_CAP=25
# Days the public link to a published post's picture stays valid (Reddit
# link posts, some Pinterest pins). 1-1825.
PUBLISHED_LINK_DAYS=365
INSIGHTS_MAX_RANGE_DAYS=366

# ── History retention ──────────────────────────────────────────────────────
HISTORY_KEEP_VERSIONS_DEFAULT=365
# 0 = keep for ever.
HISTORY_KEEP_DAYS_DEFAULT=0
HISTORY_MIN_VERSIONS_KEPT=5
