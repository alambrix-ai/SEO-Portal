# ═══════════════════════════════════════════════════════════════════════════
#  AutoMarket AI — backend configuration
#
#  Copy to .env and fill in. Values marked REQUIRED IN PRODUCTION are checked
#  at startup: the app refuses to boot with APP_ENV=production without them.
#  Run `python manage.py check` for a pre-flight report.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="AutoMarket AI"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Base for the links in invitation emails.
# REQUIRED IN PRODUCTION to be https.
PUBLIC_BASE_URL=http://localhost:5173

# ── Sessions & tokens ──────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — signs access tokens.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=14

# ── One-time passcodes ─────────────────────────────────────────────────────
# There are no passwords. Signing in means proving control of a mailbox: the
# server emails a code and the caller sends it back. These four numbers are
# therefore the entire security margin of the login system.
#
# Six digits is a million possibilities, which is only safe because a code
# lives for minutes, dies after a few wrong guesses, and is replaced the moment
# another is requested. Shortening the TTL or tightening the attempt cap buys
# far more than lengthening the code.
LOGIN_CODE_LENGTH=6
# Startup refuses more than 30 in production: a live credential sitting in a
# mailbox should not be valid for an hour.
LOGIN_CODE_TTL_MINUTES=10
# Wrong guesses before the code is dead. Production refuses more than 10.
LOGIN_CODE_MAX_ATTEMPTS=5
# Minimum gap between codes for one address: stops the sign-in form being used
# as a mail cannon, and stops an attacker cycling codes to widen the space
# they can guess against.
LOGIN_CODE_RESEND_SECONDS=60

# ── Encryption at rest ─────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Master key-encrypting key, base64 of 32 bytes.
# Every organisation's own data key is wrapped with this one. Losing it means
# losing all customer payloads; leaking it undoes encryption at rest. Keep it
# in a secret manager or KMS, never in the repo.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=
MASTER_KEY_VERSION=1
# Previous keys, so rows written under them stay readable while you re-wrap
# with `manage.py rotate-keys`. Comma-separated "<version>:<base64key>".
MASTER_ENCRYPTION_KEY_RETIRED=

# REQUIRED IN PRODUCTION. Separate HMAC key for blind indexes (encrypted-email
# lookup) and for hashing refresh/verification tokens. Must differ from the
# master key — startup rejects them being equal.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BLIND_INDEX_KEY=

# ── Transport security ─────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION to be true: redirects http->https and emits HSTS.
FORCE_HTTPS=false
HSTS_MAX_AGE_SECONDS=31536000
SECURE_COOKIES=true
COOKIE_DOMAIN=
# REQUIRED IN PRODUCTION — the real hostnames, not "*".
TRUSTED_HOSTS=*

# ── CORS ───────────────────────────────────────────────────────────────────
# The origins the console is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=automarket
POSTGRES_USER=automarket_app
POSTGRES_PASSWORD=
# REQUIRED IN PRODUCTION: require | verify-ca | verify-full
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
# A full DSN overrides the discrete fields above.
# DATABASE_URL=postgresql+psycopg://automarket_app:pass@host:5432/automarket?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Postgres row-level security. Leave on: it is the backstop that keeps one
# organisation's rows out of another's console if a query forgets its filter.
DB_ENFORCE_RLS=true

# ── Registration policy ────────────────────────────────────────────────────
ALLOW_PUBLIC_SIGNUP=true
BLOCK_PUBLIC_EMAIL_DOMAINS=false

# ── Rate limiting & lockout ────────────────────────────────────────────────
# REQUIRED IN PRODUCTION to be true. This is what keeps the code-request
# endpoints from being used to enumerate addresses or flood a mailbox.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=240
# Wrong codes across any number of issued codes before the account itself is
# locked. Without this, an attacker could request a new code they cannot read
# and guess a few times against each, indefinitely.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# ── Outbound email ─────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION, unconditionally. Mail is not a notification channel
# on this platform — it is the authentication channel. Without a mail server
# nobody can sign in at all.
#
# With SMTP_HOST empty, codes are written to the log instead of sent, which is
# how local development works and precisely why production refuses to run
# that way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=

# ── Agent orchestration ────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# Divides every agent interval. Leave at 1.0 in production; raise it in
# development so a run is observable in minutes rather than hours.
SCHEDULER_SPEED=1.0

# Set true to move agent runs onto Celery workers instead of the API process.
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── The model ──────────────────────────────────────────────────────────────
# Which vendor runs the agents. One of: anthropic | openai | gemini | grok
LLM_PROVIDER=anthropic

# REQUIRED, with no default anywhere in the code. The model decides what gets
# written to a customer's site and what it costs, so it is named explicitly or
# the process refuses to build a provider at all.
#   anthropic : claude-opus-5, claude-sonnet-5, claude-haiku-4-5
#   openai    : the model id from your account's model list
#   gemini    : gemini-2.5-pro, gemini-2.5-flash
#   grok      : grok-4, grok-3
LLM_MODEL=

# One key per vendor, so switching LLM_PROVIDER does not mean re-entering
# credentials. Only the selected provider's key is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# API roots. Override to route through your own gateway, a regional endpoint
# or an audited proxy — no code change needed.
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROK_BASE_URL=https://api.x.ai
ANTHROPIC_API_VERSION=2023-06-01

# Thinking depth and spend dial, where the provider supports one:
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3

# Cost attribution, in your currency per million tokens. Left at zero, agent
# run costs read zero and a warning says so at startup — deliberately, rather
# than a built-in price table that goes stale the week a vendor changes its
# rates, silently, in a number the console reports as spend.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# There is no fallback provider and no fallback model. If the configured one
# is unreachable the agents report that they are waiting on a model rather
# than quietly asking a different vendor — copy on a customer's page should
# only ever come from the model somebody chose.

# ── Orchestration tuning ───────────────────────────────────────────────────
# How much work one tick may claim, in total and per workspace, so a busy
# organisation cannot monopolise a tick.
SCHEDULER_MAX_PER_TICK=12
SCHEDULER_MAX_PER_TENANT_PER_TICK=4
# How long a claimed agent is left alone before another worker may retry it.
# Longer than the slowest agent run, shorter than its interval.
SCHEDULER_CLAIM_LEASE_MINUTES=15
# How often connected integrations are re-probed, so the Connectors screen
# stays current without anybody pressing anything.
CONNECTOR_HEALTH_SWEEP_MINUTES=30
# Consecutive failures before an agent is parked for a human to look at.
AGENT_MAX_CONSECUTIVE_FAILURES=5

# ── Connector transport ────────────────────────────────────────────────────
CONNECTOR_TIMEOUT_SECONDS=20
CONNECTOR_MAX_ATTEMPTS=3
# Ceiling on a repository walk, for the GitHub and Bitbucket connectors.
# Narrow the content folder rather than raising these.
REPO_MAX_FILES=4000
REPO_MAX_DEPTH=6

# ── Site crawler ───────────────────────────────────────────────────────────
# Ceiling on one crawl of a customer's site. Bounded because the platform is
# fetching somebody's production pages on a schedule, not browsing.
CRAWLER_MAX_PAGES=300

# ── What counts as a page in a repository ──────────────────────────────────
# The built-in list already covers Markdown, the template languages, and the
# server-rendered stacks (.php, .erb, .twig, .cshtml). These two add to it
# rather than replacing it, so a stack nobody here has heard of is one line
# of configuration away from working instead of a code change.
#   CONTENT_EXTENSIONS_EXTRA=.dhtml,.shtml
CONTENT_EXTENSIONS_EXTRA=
# Directory names that mark where routing starts, used to turn a file path
# into the URL it is published at.
#   ROUTE_DIRS_EXTRA=pagina,seiten
ROUTE_DIRS_EXTRA=

# ── Technical SEO audit ────────────────────────────────────────────────────
# Google publishes no minimum word count. 300 is a working threshold for
# "thin", which is why it is a setting you can argue with per deployment
# rather than a constant in the code.
SEO_THIN_CONTENT_WORDS=300
# Core Web Vitals field data is quota-limited, so one run measures a bounded
# number of pages rather than the whole site every time.
SEO_VITALS_PAGES_PER_RUN=25
# Page bodies fetched per sync. The listing is one call; each body is another,
# against the customer's own site, so a large site fills in over a few runs
# rather than being re-read in full every time.
SEO_PAGES_READ_PER_RUN=25

# ── What a new workspace gets ──────────────────────────────────────────────
# Commercial facts, which change without the software changing.
DEFAULT_PLAN_NAME=Enterprise Plan
DEFAULT_SEATS=25
DEFAULT_PLAN_DAYS=30
# Where a freshly reset agent sends notifications: Slack | Email | None.
# None by default, so a reset cannot start delivering somewhere nobody chose.
DEFAULT_NOTIFY_CHANNEL=None

# ── Money ──────────────────────────────────────────────────────────────────
# What the customer's spend and CAC are reported in. Grouping is separate from
# the symbol because it is not implied by it: "indian" gives the lakh/crore
# grouping (₹12,34,567 and ₹4.57Cr), "western" gives thousands.
CURRENCY_SYMBOL=₹
CURRENCY_GROUPING=indian
