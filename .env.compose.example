# Settings for the docker compose stack. Copy to `.env` and fill in.
#
#   cp .env.compose.example .env
#
# Compose reads this file twice: to fill in docker-compose.yml, and as the
# environment of every backend container (api, workers, beat, migrate). Any
# other setting from backend/.env.example can be added here too.
#
# Never commit `.env`. Values are taken literally; avoid `$` in passwords, or
# wrap the whole value in single quotes.

# ── Environment ────────────────────────────────────────────────────────────
# production for a real deployment (the API then refuses to start with an
# unsafe setting and says which); development on a laptop.
APP_ENV=production

# ── Database ───────────────────────────────────────────────────────────────
# Two roles, created once by backend/scripts/bootstrap.sql (see the header of
# docker-compose.yml for the command):
#   automarket_owner  owns the schema; used ONLY by the `migrate` service
#   automarket_app    what the API, workers and beat connect as; owns nothing
# Replace each <...-password> with the real password, URL-encoded (for
# example @ becomes %40). sslmode=require is mandatory in production.
MIGRATION_DATABASE_URL=postgresql+psycopg://automarket_owner:<owner-password>@postgres:5432/automarket?sslmode=require
DATABASE_URL=postgresql+psycopg://automarket_app:<app-password>@postgres:5432/automarket?sslmode=require

# Superuser password for the bundled PostgreSQL container (not used by the
# application). Not needed with a managed database.
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# ── Redis (required) ───────────────────────────────────────────────────────
# Password for the bundled Redis. Letters and digits only, 24 or more (it is
# placed in the redis:// URLs); Redis refuses to start otherwise.
#   python -c "import secrets;print(secrets.token_hex(24))"
REDIS_PASSWORD=

# ── Keys (required) ────────────────────────────────────────────────────────
# Signs access tokens.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Wraps every organisation's data-encryption key. Base64 of exactly 32 bytes.
# Keep this stable across rebuilds, or previously encrypted rows become
# unreadable.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=

# HMAC key for encrypted-email lookup and token hashing. Must differ from the
# master key.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BLIND_INDEX_KEY=

# ── Public addresses (required in production) ──────────────────────────────
# The https address people open, the hostnames the API answers to, and the
# browser origins allowed to call it. Uncomment and fill in for production;
# left commented, the development defaults (localhost) apply.
# PUBLIC_BASE_URL=https://marketing.example.com
# Production refuses TRUSTED_HOSTS empty or '*'; list every hostname the API
# answers to. A blank value disables host checking (Host-header reflection).
# TRUSTED_HOSTS=marketing.example.com
# CORS_ORIGINS=https://marketing.example.com
# List the real public origin FIRST in CORS_ORIGINS: WebAuthn/passkeys take
# the RP ID from that hostname.
# FORCE_HTTPS=true
# Operators with portal-wide admin rights (comma-separated).
# PORTAL_ADMIN_EMAILS=it-admin@your-company.com
# The bundled console and API are meant to sit behind your reverse proxy:
# with FORCE_HTTPS=true, production also needs TRUSTED_PROXIES below (or
# EDGE_TLS_TERMINATED=true when the proxy's address cannot be listed), or
# the API refuses to start.

# ── Enterprise SSO (SAML / OIDC) ───────────────────────────────────────────
# Fail-closed until an IdP is certified. Safe defaults keep SSO off.
SSO_LOGIN_ENABLED=false
SSO_CLOCK_SKEW_SECONDS=120
SSO_REPLAY_TTL_SECONDS=600

# ── Commercial billing ─────────────────────────────────────────────────────
# Only "fake" is enabled without a certified payment provider decision.
BILLING_PROVIDER=fake
# Optional JSON plan catalogue; empty uses the built-in fake catalogue.
BILLING_PLAN_CATALOG=

# ── Reverse proxy and client addresses ─────────────────────────────────────
# The proxies whose X-Forwarded-For the API believes, as IPs or CIDRs
# (comma-separated). Never 0.0.0.0/0 or ::/0 (production refuses them).
# Pick the line for your setup:
#   Reverse proxy on the Docker host (nginx, Caddy, Traefik) reaching the
#     published 127.0.0.1:8000: it arrives from the compose gateway.
#       TRUSTED_PROXIES=172.28.0.1/32
#   Reverse proxy as a container on this compose network: its own address
#     (pin it with ipv4_address). Avoid trusting all of 172.28.0.0/24.
#       TRUSTED_PROXIES=172.28.0.10/32
#   Cloud load balancer (AWS ALB, Azure Application Gateway, GCP): the load
#     balancer's subnet CIDRs or proxy ranges.
#   Network load balancer that keeps the client address (e.g. AWS NLB with
#     instance targets), or no proxy at all: leave empty.
# Check after deploying: the client address the API records for your own
# requests should be your public IP, not the proxy's.
# Also required for per-workspace IP allowlists behind a proxy: without it
# X-Forwarded-For is ignored and allowlists see the proxy, not the client.
TRUSTED_PROXIES=

# ── Email (required in production) ─────────────────────────────────────────
# Sign-in is a one-time code sent by email, so mail is the login system.
# Production sends through Resend. In development with SMTP_HOST empty, codes
# are printed to the API log instead (`docker compose logs -f api`).
RESEND_API_KEY=
# EMAIL_FROM=no-reply@marketing.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Workers ────────────────────────────────────────────────────────────────
# Processes for the general queue, and tasks before a process is recycled.
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=50
# Processes for the "render" queue (one headless Chromium each). Raise the
# render-worker's memory limit in docker-compose.yml with it (about 1.5 GB
# per process).
CELERY_RENDER_CONCURRENCY=1
# CREATIVE_RENDER_ISOLATED is set only on render-worker in docker-compose.yml
# (not here, and not on api/worker/beat). It does not allow unsandboxed
# Chromium unless CELERY_ENABLED is also true.

# ── Self-hosted models (Ollama, vLLM) ──────────────────────────────────────
# Private hostnames or CIDRs a self-hosted model connector may reach
# (comma-separated). Leave commented out unless you run one; public
# addresses need no entry and cloud metadata addresses are always blocked.
# SELF_HOSTED_LLM_ALLOWED_HOSTS=ollama.internal,10.20.0.0/24

# ── Creative Studio models ─────────────────────────────────────────────────
# Recommended allow and deny lists (comma-separated glob patterns; the deny
# lists win). An empty allow list approves nothing, and Creative Studio then
# asks for an administrator. Review against each vendor's model list before
# going live; model ids change often.
CREATIVE_ALLOWED_TEXT_MODELS=claude-*,gpt-*,o[0-9]*,gemini-*,sonar*,grok-*,ollama:*,vllm:*
CREATIVE_DENIED_TEXT_MODELS=*image*,*realtime*,*audio*,*tts*,*transcribe*,*embedding*,*-live*,gemini-nano-banana*,*video*
CREATIVE_ALLOWED_IMAGE_MODELS=gpt-image-*,chatgpt-image-*,gemini-*-image*,gemini-nano-banana*
CREATIVE_DENIED_IMAGE_MODELS=dall-e-*,gpt-image-1

# ── Console (production profile) ───────────────────────────────────────────
# Where the browser finds the API: a same-origin path behind the reverse
# proxy, or the API's https URL.
VITE_API_BASE_URL=/api/v1
# Send the Content-Security-Policy as Report-Only first; set false to enforce.
CSP_REPORT_ONLY=true

# ── Ports ──────────────────────────────────────────────────────────────────
# Address the API (8000) and the production console (8080) are published on.
# Keep 127.0.0.1 and let the reverse proxy reach them.
PUBLISH_ADDR=127.0.0.1
