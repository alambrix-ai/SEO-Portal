# Shell scripts and nginx configs run inside Linux containers: CRLF line
# endings break them (a "\r" ends up in the shebang or a directive).
*.sh        text eol=lf
nginx.conf  text eol=lf
*.conf      text eol=lf
*.conf.template text eol=lf
# Font licences are hashed in fonts.lock; CRLF on Windows would fail the
# Linux image build (sha256sum -c). Keep them LF in the repo and worktree.
backend/app/services/creative/assets/fonts/**/OFL.txt text eol=lf
