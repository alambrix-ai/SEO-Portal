__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Node ──────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/

# ── Local artefacts ───────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
frontend-src-backup-before-redesign/
